{
	"compilerOptions": {
		"noEmit": true,

		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "Bundler",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		
		"skipLibCheck": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,

		"jsxImportSource": "vue",
	},
}
